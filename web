nav{display:flex;align-items:center;gap:34px;font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase}
nav a{color:#d9dadd;transition:color .2s}nav a:hover{color:var(--gold)}
.nav-cta{border:1px solid #777;padding:13px 18px}
